NODE_ENV=development
PORT=4000
# MongoDB replica set (Atlas or local hcm replica set); transactions are required.
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite?replicaSet=hcm
# Local setup: npm run setup:env generates/preserves a strong key without printing it.
JWT_SECRET=
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
# Optional password-recovery email. Core registration/login work without SMTP.
# Use your real SMTP server; credentials stay backend-only.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Trusted reset-link destination. HTTPS is required in production.
AUTH_APP_URL=http://localhost:3000
# Optional: hosted OpenAI-compatible tool-calling provider. No browser key.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=

# Optional local face attendance; ordinary attendance remains available without it.
# Install Python CPU runtime and SHA-256-verified models: bash scripts/setup-local-face.sh
# Base64 of exactly32 random bytes; backend-only stable AES-256-GCM key.
# npm run setup:env creates it for local development without printing it.
BIOMETRIC_TEMPLATE_KEY=
BIOMETRIC_TEMPLATE_KEY_ID=v1
# Optional absolute paths (empty uses backend/.local-face-venv/bin/python and models/local-face).
BIOMETRIC_PYTHON_PATH=
BIOMETRIC_MODEL_DIR=
# Cosine similarity, not a percentage; calibrate with real devices/workforce.
BIOMETRIC_MATCH_THRESHOLD=0.363
BIOMETRIC_RETENTION_DAYS=365
# No reliable liveness/PAD is provided by YuNet/SFace. No AWS/API key is required.
# Legacy AWS references, if any, need a separate confirmed deletion process.
# Preserve former BIOMETRIC_REFERENCE_KEY/_ID securely until legacy cleanup is complete.
# Restrict this to actual trusted reverse proxy addresses/subnets in production.
TRUST_PROXY=loopback
