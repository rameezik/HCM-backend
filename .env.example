NODE_ENV=development
PORT=4000
# MongoDB replica set (Atlas or local hcm replica set); transactions are required.
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite?replicaSet=hcm
# Generate securely: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
# Optional: hosted OpenAI-compatible tool-calling provider. No browser key.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
